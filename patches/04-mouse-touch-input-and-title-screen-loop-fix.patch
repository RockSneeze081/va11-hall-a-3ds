-STUB_RETURN_ZERO(get_timer)
+
+// get_timer() was previously stubbed to always return 0, which silently breaks any GML code
+// that times itself against it (e.g. `alpha = (get_timer() - startTime) / fadeDuration`) - such
+// code reads 0 - 0 = 0 forever, since startTime was also captured as the stubbed 0. This mirrors
+// BUILTIN_VAR_CURRENT_TIME's platform branches above, just in microseconds instead of
+// milliseconds to match real GameMaker's get_timer() semantics. As with current_time, this is an
+// absolute monotonic clock rather than one relative to game start, which is fine since callers
+// only ever use it in deltas.
+static RValue builtin_get_timer(MAYBE_UNUSED VMContext* ctx, MAYBE_UNUSED RValue* args, MAYBE_UNUSED int32_t argCount) {
+    #ifdef _WIN32
+    LARGE_INTEGER freq, counter;
+    QueryPerformanceFrequency(&freq);
+    QueryPerformanceCounter(&counter);
+    GMLReal us = (GMLReal) counter.QuadPart / (GMLReal) freq.QuadPart * 1000000.0;
+    #elif defined(PLATFORM_PS3)
+    GMLReal us = (GMLReal) (__builtin_ppc_get_timebase() / sysGetTimebaseFrequency());
+    #else
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    GMLReal us = (GMLReal) ts.tv_sec * 1000000.0 + (GMLReal) ts.tv_nsec / 1000.0;
+    #endif
+    return RValue_makeReal(us);
+}
