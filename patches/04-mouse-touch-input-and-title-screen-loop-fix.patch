+// Mouse functions. Button state itself is fed by the platform layer (e.g. from hidTouchRead()
+// on 3DS) into runner->mouseLeft/Right/Middle*; a touch panel only ever reports one point, so
+// mb_right/mb_middle stay permanently false there, but the fields exist for platforms with a
+// real mouse.
+static bool mouseButtonIsDown(Runner* runner, int32_t button) {
+    switch (button) {
+        case 1: return runner->mouseLeftDown;
+        case 2: return runner->mouseRightDown;
+        case 3: return runner->mouseMiddleDown;
+        case -1: return runner->mouseLeftDown || runner->mouseRightDown || runner->mouseMiddleDown;
+        default: return false;
+    }
+}
+
+static bool mouseButtonWasPressed(Runner* runner, int32_t button) {
+    switch (button) {
+        case 1: return runner->mouseLeftPressed;
+        case 2: return runner->mouseRightPressed;
+        case 3: return runner->mouseMiddlePressed;
+        case -1: return runner->mouseLeftPressed || runner->mouseRightPressed || runner->mouseMiddlePressed;
+        default: return false;
+    }
+}
+
+static bool mouseButtonWasReleased(Runner* runner, int32_t button) {
+    switch (button) {
+        case 1: return runner->mouseLeftReleased;
+        case 2: return runner->mouseRightReleased;
+        case 3: return runner->mouseMiddleReleased;
+        case -1: return runner->mouseLeftReleased || runner->mouseRightReleased || runner->mouseMiddleReleased;
+        default: return false;
+    }
+}
+
+static RValue builtinMouseCheckButton(VMContext* ctx, RValue* args, int32_t argCount) {
+    if (1 > argCount) return RValue_makeBool(false);
+    Runner* runner = (Runner*) ctx->runner;
+    return RValue_makeBool(mouseButtonIsDown(runner, RValue_toInt32(args[0])));
+}
+
+static RValue builtinMouseCheckButtonPressed(VMContext* ctx, RValue* args, int32_t argCount) {
+    if (1 > argCount) return RValue_makeBool(false);
+    Runner* runner = (Runner*) ctx->runner;
+    return RValue_makeBool(mouseButtonWasPressed(runner, RValue_toInt32(args[0])));
+}
+
+static RValue builtinMouseCheckButtonReleased(VMContext* ctx, RValue* args, int32_t argCount) {
+    if (1 > argCount) return RValue_makeBool(false);
+    Runner* runner = (Runner*) ctx->runner;
+    return RValue_makeBool(mouseButtonWasReleased(runner, RValue_toInt32(args[0])));
+}
