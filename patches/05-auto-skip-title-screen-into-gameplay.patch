+        // title_screen renders as a black screen on this port (unresolved rendering bug - real
+        // touch input demonstrably reaches its click-to-play objects, but nothing is visible to
+        // click on). Rather than leave the game stuck on a black screen, auto-advance straight
+        // into real gameplay the same way the languageselect skip above does: jump to whatever
+        // room the game's own room order says comes after title_screen. Every room upstream of
+        // here (splash screens, intro narration) renders correctly, so this should land on the
+        // genuine first gameplay scene with working art.
+        if (!n3dsSkippedTitleScreen && runner->currentRoom != NULL && runner->currentRoom->name != NULL &&
+            strcmp(runner->currentRoom->name, "title_screen") == 0) {
+            n3dsSkippedTitleScreen = true;
+            int32_t targetRoom = -1;
+            for (uint32_t i = 0; i + 1 < dataWin->gen8.roomOrderCount; i++) {
+                if (dataWin->gen8.roomOrder[i] == runner->currentRoomIndex) {
+                    targetRoom = dataWin->gen8.roomOrder[i + 1];
+                    break;
+                }
+            }
+            N3DS_debugLog("auto-skip title_screen -> target room index %ld\n", (long) targetRoom);
+            if (targetRoom >= 0) {
+                runner->pendingRoom = targetRoom;
+            }
+        }
