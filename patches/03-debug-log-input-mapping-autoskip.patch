+// fprintf(stderr, ...) has nowhere to go once citro2d owns the screen (no consoleInit() console
+// active), so this writes straight to the SD card where it can actually be read back afterwards.
+static void N3DS_debugLog(const char* fmt, ...) {
+    FILE* f = fopen("sdmc:/3ds/cinnamon/debug.txt", "a");
+    if (f == NULL) return;
+    va_list args;
+    va_start(args, fmt);
+    vfprintf(f, fmt, args);
+    va_end(args);
+    fclose(f);
+}
